{
  "rules": {
    "users": {
      ".read": true,
      "$username": {
        ".write": true,
        ".validate": "newData.hasChildren(['password', 'balance'])",
        "password": {
          ".validate": "newData.isString() && newData.val().length >= 1"
        },
        "balance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "usdt": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "username": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "displayName": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "avatar": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "role": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "online": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "mining": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "miningStartTime": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "balanceUpdatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "miningUpdatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "createdAt": {
          ".validate": "!newData.exists() || newData.isString() || newData.isNumber()"
        },
        "tournamentsWon": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "transactions": {
      ".read": true,
      ".write": true,
      "$txId": {
        ".validate": "newData.hasChildren(['from', 'to', 'amount'])",
        "from": {
          ".validate": "newData.isString() && newData.val().length >= 1"
        },
        "to": {
          ".validate": "newData.isString() && newData.val().length >= 1"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "fee": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "totalAmount": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
        },
        "currency": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "timestamp": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "ts": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "chats": {
      ".read": true,
      ".write": true
    },
    "groupChats": {
      ".read": true,
      ".write": true
    },
    "config": {
      ".read": true,
      ".write": true
    },
    "workshopIds": {
      ".read": true,
      ".write": true
    },
    "workshopMarketplace": {
      ".read": true,
      ".write": true
    },
    "market": {
      ".read": true,
      ".write": true
    },
    "marketTrades": {
      ".read": true,
      ".write": true
    },
    "marketOrders": {
      ".read": true,
      ".write": true
    },
    "newsPosts": {
      ".read": true,
      ".write": true
    },
    "userQuestProgress": {
      ".read": true,
      ".write": true
    },
    "candleHistory": {
      ".read": true,
      ".write": true
    },
    "rpsMatches": {
      ".read": true,
      ".write": true
    },
    "promoCodes": {
      ".read": true,
      ".write": true
    },
    "tournaments": {
      ".read": true,
      ".write": true
    },
    "weeklyProgress": {
      ".read": true,
      ".write": true
    },
    "weeklyCompleted": {
      ".read": true,
      ".write": true
    },
    "weeklyTop3": {
      ".read": true,
      ".write": true
    }
  }
}
